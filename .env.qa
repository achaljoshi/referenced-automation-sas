# Non-secret settings for the 'qa' environment. Secrets (SAS_PASSWORD ...) go in .env.qa.local, never committed: copy .env.local.example.
# Every variable is explained in .env.example. Remove the "# " in front of a line to use it and replace the PLACEHOLDER value with yours.
# Declare 'qa' (its kind and hosts) in env/sas-environments.json (see env/sas-environments.json.example): an environment that is not
# declared is refused.
ENV=qa

# The profile names exactly as the programs' connection dialogs list them (Management Console: "Connection Profile"; Enterprise Guide: "Select Profile").
# SAS_SMC_PROFILE=QA Metadata Server
# SAS_EG_PROFILE=QA SAS Server

# Where the programs are installed (needed only to LAUNCH them; leave commented out to attach to programs you started yourself).
# SAS_SMC_PATH=C:\Program Files\SASHome\SASManagementConsole\9.4\sasmc.exe
# SAS_EG_PATH=C:\Program Files\SASHome\SASEnterpriseGuide\8\SEGuide.exe

# Your user name (not a secret). The password is SAS_PASSWORD in .env.qa.local.
# SAS_USER=ajoshi
