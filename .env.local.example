# =====================================================================================================================
# .env.local.example - the template for the file that holds your SECRETS.
#
#   1. Copy it to .env.<ENV>.local:   Copy-Item .env.local.example .env.qa.local        (PowerShell)    cp .env.local.example .env.qa.local
#      (ENV=qa -> .env.qa.local, ENV=dev -> .env.dev.local ...). The file must carry the environment's name: a file named just
#      .env.local is NOT read.
#   2. Fill it in below (remove the "# " in front of the lines you need).
#   3. Never commit it: .gitignore already ignores every .env.*.local file.
#
# It overrides .env.<ENV>, and a real environment variable (a masked CI variable, or $env:SAS_PASSWORD = '...') overrides it.
# Write a value with special characters (# $ spaces) in double quotes - an unquoted # starts a comment and cuts the password:
#     SAS_PASSWORD="my#pass word"
# Inside double quotes \n is a line break: use single quotes for a password that contains a backslash.
#
# Every variable marked "Secret: YES" in .env.example is listed here. A WRONG SAS_PASSWORD counts towards the account's lock limit: log on
# to the program by hand with exactly these values first. See SAS_LOGON_FAILURE_COOLDOWN_MIN in .env.example.
# =====================================================================================================================


# The password of SAS_USER (set SAS_USER, SAS_SMC_PROFILE and SAS_EG_PROFILE in .env.<ENV>).
# SAS_PASSWORD="change-me"

# One password per program, if the programs use different logins: SAS_SMC_PASSWORD, SAS_EG_PASSWORD (with SAS_SMC_USER / SAS_EG_USER in .env.<ENV>). User and password come as a pair.
# SAS_<APP>_PASSWORD="change-me"

# The Windows password of the remote desktop host (SAS_DESKTOP_TRANSPORT=remote with REMOTE_AGENT_START=alternate-shell). Not a SAS password.
# REMOTE_RDP_PASSWORD="change-me"

# Secrets that a recorded flow typed into a PIN / one-time code / token / secret / api key field: the converter writes a read of these.
# SAS_PIN="change-me"
# SAS_OTP="change-me"
# SAS_TOKEN="change-me"
# SAS_SECRET="change-me"
# SAS_API_KEY="change-me"
