{
  "name": "@automation/referenced-automation-sas",
  "version": "1.0.0",
  "description": "SAS desktop automation on Playwright: a policy gate, logon protection, audit and clean-up in front of the command-line and COM drivers and a Windows UI Automation layer (PowerShell bridge) for SAS Management Console and SAS Enterprise Guide, with fixtures, Gherkin steps, a recorder and a built-in stand-in desktop. SAS Viya is out of scope (see the api and ui packages).",
  "license": "UNLICENSED",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "bridge"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "prebuild": "node bridge/generate-hash.js",
    "build": "tsc -p tsconfig.build.json",
    "clean": "rimraf --glob dist \"*.tgz\"",
    "lint": "eslint . --ext .ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bddgen && playwright test",
    "test:ci": "bddgen && playwright test && node scripts/min-executed.js --min 600",
    "test:bdd": "bddgen && playwright test --project=bdd --workers=50% && node scripts/min-executed.js --min 12",
    "test:smoke": "bddgen && playwright test --grep @smoke && node scripts/min-executed.js --min 9",
    "test:regression": "bddgen && playwright test --grep @regression && node scripts/min-executed.js --min 3",
    "test:conformance": "node scripts/run-real.js @real-conformance",
    "test:real-smoke": "node scripts/run-real.js @real-smoke",
    "try:simulator": "node scripts/try-simulator.js",
    "pretest": "npm run build",
    "prepack": "npm run build",
    "install:browsers": "playwright install --with-deps chromium",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:report": "npm run allure:generate && npm run allure:open",
    "security": "automation-audit-gate --allow-unassigned && automation-scan-secrets",
    "audit": "automation-framework-audit --run",
    "audit:quick": "automation-framework-audit",
    "inspect": "node dist/desktop/cli/inspect.js inspect",
    "inspect:windows": "node dist/desktop/cli/inspect.js windows",
    "doctor": "node dist/desktop/cli/inspect.js doctor",
    "bridge:path": "node dist/desktop/cli/inspect.js --print-bridge",
    "bridge:hash": "node bridge/generate-hash.js",
    "bridge:hash:check": "node bridge/generate-hash.js --check",
    "record": "node dist/recorder/cli/record.js",
    "record:convert": "node dist/recorder/cli/convert.js",
    "record:import-script": "node dist/recorder/cli/importScript.js"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.64.0 <2.0.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.10.5",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "allure-commandline": "^2.32.0",
    "allure-playwright": "^3.0.9",
    "eslint": "^8.57.1",
    "playwright-bdd": "9.2.1",
    "playwright-core": "^1.64.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@automation/referenced-automation-api": "^1.0.0",
    "@automation/referenced-automation-ui": "^1.0.0",
    "@automation/referenced-automation-utils": "^1.0.0"
  },
  "bin": {
    "sas-desktop-inspect": "./dist/desktop/cli/inspect.js",
    "sas-desktop-record": "./dist/recorder/cli/record.js",
    "sas-desktop-to-playwright": "./dist/recorder/cli/convert.js",
    "sas-eg-import-script": "./dist/recorder/cli/importScript.js"
  }
}
